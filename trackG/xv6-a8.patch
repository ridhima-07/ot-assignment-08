diff --git a/user/cowbench.c b/user/cowbench.c
new file mode 100644
index 0000000..bdf3c7d
--- /dev/null
+++ b/user/cowbench.c
@@ -0,0 +1,92 @@
+// [A8 Track G] copy-on-write fork benchmark + correctness test.
+//   cowbench <cow 0|1> <test 1..4>   (test 0 = just set the COW switch)
+// 1 fork+exit latency with a 2 MB heap   2 child writes 0/25/50/100% of the heap
+// 3 memory footprint of 8 live children  4 isolation / correctness (parent & child never see each other's writes)
+#include "kernel/types.h"
+#include "user/user.h"
+
+#define HEAP_PAGES 512
+#define PG 4096
+static char *heap;
+
+static void touch_all(char v) { for (int i = 0; i < HEAP_PAGES; i++) heap[i * PG] = v + (i & 7); }
+
+static void snap(struct memstat *m) { if (memstat(m) < 0) { printf("memstat failed\n"); exit(1); } }
+
+int main(int argc, char *argv[]) {
+  if (argc < 3) { printf("usage: cowbench cow test\n"); exit(1); }
+  int cow = atoi(argv[1]), test = atoi(argv[2]);
+  setcow(cow);
+  if (test == 0) { printf("cow set to %d\n", cow); exit(0); }   // leave COW on (e.g. for usertests)
+  heap = sbrk(HEAP_PAGES * PG);
+  if (heap == (char *)-1) { printf("sbrk failed\n"); exit(1); }
+  touch_all(1);
+  struct memstat a, b;
+
+  if (test == 1) {
+    int iters = 20;
+    snap(&a);
+    for (int k = 0; k < iters; k++) {
+      int pid = fork();
+      if (pid == 0) exit(0);
+      wait(0);
+    }
+    snap(&b);
+    printf("COW test=1 cow=%d iters=%d avg_us=%d pages_copied=%d pages_shared=%d cow_faults=%d\n", cow, iters,
+           (int)((b.time - a.time) / 10 / iters), (int)(b.fork_pages_copied - a.fork_pages_copied + b.cow_copies - a.cow_copies),
+           (int)(b.fork_pages_shared - a.fork_pages_shared), (int)(b.cow_faults - a.cow_faults));
+  } else if (test == 2) {
+    int pct[] = { 0, 25, 50, 100 };
+    for (int j = 0; j < 4; j++) {
+      int iters = 5;
+      snap(&a);
+      for (int k = 0; k < iters; k++) {
+        int pid = fork();
+        if (pid == 0) {
+          int n = HEAP_PAGES * pct[j] / 100;
+          for (int i = 0; i < n; i++) heap[i * PG] = 9;
+          exit(0);
+        }
+        wait(0);
+      }
+      snap(&b);
+      printf("COW test=2 cow=%d write_pct=%d avg_us=%d pages_copied=%d cow_faults=%d\n", cow, pct[j],
+             (int)((b.time - a.time) / 10 / iters), (int)(b.fork_pages_copied - a.fork_pages_copied + b.cow_copies - a.cow_copies),
+             (int)(b.cow_faults - a.cow_faults));
+    }
+  } else if (test == 3) {
+    int kids = 8, pids[8];
+    snap(&a);
+    for (int k = 0; k < kids; k++) {
+      pids[k] = fork();
+      if (pids[k] == 0) { pause(10); exit(0); }
+    }
+    snap(&b);
+    printf("COW test=3 cow=%d children=%d pages_used_by_children=%d free_before=%d free_after=%d\n", cow, kids,
+           (int)(a.freepages - b.freepages), (int)a.freepages, (int)b.freepages);
+    for (int k = 0; k < kids; k++) wait(0);
+  } else if (test == 4) {
+    int bad = 0;
+    touch_all(1);
+    int pid = fork();
+    if (pid == 0) {
+      for (int i = 0; i < HEAP_PAGES; i++) if (heap[i * PG] != 1 + (i & 7)) exit(1);   // sees parent's data
+      touch_all(50);                                                                   // private writes
+      int g = fork();                                                                  // nested COW
+      if (g == 0) { touch_all(90); exit(0); }
+      int st; wait(&st);
+      for (int i = 0; i < HEAP_PAGES; i++) if (heap[i * PG] != 50 + (i & 7)) exit(2);  // grandchild did not leak
+      exit(st == 0 ? 0 : 3);
+    }
+    int st; wait(&st);
+    for (int i = 0; i < HEAP_PAGES; i++) if (heap[i * PG] != 1 + (i & 7)) bad++;
+    // a pipe write (copyout into a COW page) must also be isolated
+    int fd[2]; pipe(fd);
+    if (fork() == 0) { read(fd[0], heap, 16); exit(heap[0] == 'x' ? 0 : 4); }
+    write(fd[1], "xxxxxxxxxxxxxxxx", 16); int st2; wait(&st2);
+    printf("COW test=4 cow=%d child_status=%d copyout_child_status=%d parent_corrupted_pages=%d parent_first_byte=%d RESULT=%s\n",
+           cow, st, st2, bad, heap[0], (st == 0 && st2 == 0 && bad == 0 && heap[0] == 1) ? "PASS" : "FAIL");
+  }
+  setcow(0);
+  exit(0);
+}
diff --git a/user/schedbench.c b/user/schedbench.c
new file mode 100644
index 0000000..f08873a
--- /dev/null
+++ b/user/schedbench.c
@@ -0,0 +1,56 @@
+// [A8 Track G] scheduler benchmark: schedbench <policy 0=RR|1=MLFQ> <workload 1|2|3>  (workload 0 = just set policy)
+// Prints one STAT line per child: kind ctime ftime etime rtime (all in timer ticks).
+#include "kernel/types.h"
+#include "user/user.h"
+
+#define UNIT 24000000  // spin iterations ~ 1 timer tick under QEMU (calibrated, see README)
+
+static void spin(int units) {
+  volatile unsigned long x = 0;
+  for (long u = 0; u < units; u++)
+    for (long i = 0; i < UNIT; i++) x += i;
+}
+
+static int kinds[64];   // pid -> kind index (pids are small in xv6)
+static char *names[] = { "long", "short", "hog", "interactive" };
+
+static int launch(int kind, int units, int interactive_iters) {
+  int pid = fork();
+  if (pid < 0) { printf("fork failed\n"); exit(1); }
+  if (pid == 0) {
+    if (interactive_iters > 0) {
+      for (int k = 0; k < interactive_iters; k++) { pause(1); spin(units); }
+    } else {
+      spin(units);
+    }
+    exit(0);
+  }
+  kinds[pid % 64] = kind;
+  return pid;
+}
+
+int main(int argc, char *argv[]) {
+  if (argc < 3) { printf("usage: schedbench policy workload\n"); exit(1); }
+  int policy = atoi(argv[1]), w = atoi(argv[2]), n = 0;
+  if (setsched(policy) < 0) { printf("setsched failed\n"); exit(1); }
+  if (w == 0) { printf("policy set to %d\n", policy); exit(0); }   // leave policy on (e.g. for usertests)
+  int t0 = uptime();
+  if (w == 1) {                 // mixed batch, all arrive together, longest first in the table
+    int len[] = { 12, 2, 6, 1, 8, 3 };
+    for (int i = 0; i < 6; i++) launch(len[i] >= 6 ? 0 : 1, len[i], 0), n++;
+  } else if (w == 2) {          // CPU hogs + interactive processes that sleep between bursts
+    for (int i = 0; i < 2; i++) launch(2, 30, 0), n++;
+    for (int i = 0; i < 3; i++) launch(3, 0, 10), n++;   // 10 x (pause 1 tick, then return to sleep)
+  } else {                      // long jobs running, short jobs arrive over time
+    for (int i = 0; i < 2; i++) launch(0, 20, 0), n++;
+    for (int i = 0; i < 6; i++) { pause(3); launch(1, 1, 0); n++; }
+  }
+  for (int i = 0; i < n; i++) {
+    struct procstat st; int status;
+    if (waitstat(&status, &st) < 0) { printf("waitstat failed\n"); exit(1); }
+    printf("STAT w=%d pol=%d kind=%s pid=%d ctime=%d ftime=%d etime=%d rtime=%d\n", w, policy,
+           names[kinds[st.pid % 64]], st.pid, st.ctime - t0, st.ftime - t0, st.etime - t0, st.rtime);
+  }
+  setsched(0);
+  exit(0);
+}
